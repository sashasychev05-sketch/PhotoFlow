<Window x:Class="PhotoFlow.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:PhotoFlow.App" Title="PhotoFlow">
 <Grid x:Name="Root" RequestedTheme="Dark" Background="{StaticResource CanvasBrush}" KeyDown="Root_KeyDown">
  <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="90"/></Grid.RowDefinitions>
  <Grid x:Name="DragRegion" Grid.ColumnSpan="2" Background="Transparent"><TextBlock Text="PhotoFlow" Margin="22,10" FontSize="12" Foreground="{StaticResource Muted}"/></Grid>
  <Grid Grid.Row="1" Grid.RowSpan="2" Padding="18,20,18,24" Background="#1C201C">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Spacing="12" Margin="12,0,0,28">
    <StackPanel Orientation="Horizontal" Spacing="10"><Border Background="{StaticResource Accent}" CornerRadius="10" Width="34" Height="34"><FontIcon Glyph="&#xE722;" FontSize="18" Foreground="#172012"/></Border><TextBlock Text="PhotoFlow" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
    <TextBlock Text="ОТБОР ДО ИМПОРТА" FontSize="10" CharacterSpacing="90" Foreground="{StaticResource Muted}"/>
   </StackPanel>
   <StackPanel Grid.Row="1" Spacing="5">
    <Button Style="{StaticResource NavButton}" Click="Library_Click"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8B9;" FontSize="17"/><TextBlock Text="Все кадры"/></StackPanel></Button>
    <Button Style="{StaticResource NavButton}" Click="Favorites_Click"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE734;" FontSize="17"/><TextBlock Text="Избранное"/></StackPanel></Button>
    <Button Style="{StaticResource NavButton}" Click="Devices_Click"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8EA;" FontSize="17"/><TextBlock Text="USB-устройства"/></StackPanel></Button>
    <TextBlock Text="ИСТОЧНИКИ" FontSize="10" CharacterSpacing="130" Foreground="{StaticResource Muted}" Margin="16,28,0,10"/>
   </StackPanel>
   <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,16"><StackPanel x:Name="SourceButtons" Spacing="5"/></ScrollViewer>
   <StackPanel Grid.Row="3" Spacing="14">
    <Button Style="{StaticResource NavButton}" Click="About_Click"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE946;" FontSize="16"/><TextBlock Text="О PhotoFlow"/></StackPanel></Button>
    <TextBlock Text="Локально. Спокойно. Ваше." Foreground="{StaticResource Muted}" FontSize="11" Margin="16,0,0,0"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1" Grid.Column="1" Padding="32,22,32,0">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,24">
    <StackPanel Spacing="5" Margin="0,0,255,0"><TextBlock Text="ВАША КОЛЛЕКЦИЯ" Foreground="{StaticResource Accent}" FontSize="10" CharacterSpacing="160"/><TextBlock x:Name="ViewTitle" Text="Все кадры" FontSize="34" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="CountLabel" Text="Откройте папку или подключите телефон" Foreground="{StaticResource Muted}" FontSize="13" TextTrimming="CharacterEllipsis"/></StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
     <Button Content="Демо" Click="Demo_Click" Padding="14,10" CornerRadius="8"/>
     <Button Click="OpenFolder_Click" Padding="16,10" CornerRadius="8"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8B7;" FontSize="15"/><TextBlock Text="Открыть папку"/></StackPanel></Button>
    </StackPanel>
   </Grid>
   <Grid Grid.Row="1" ColumnSpacing="10" Margin="0,0,0,22">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="145"/><ColumnDefinition Width="165"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <AutoSuggestBox x:Name="Search" PlaceholderText="Найти по имени…" TextChanged="Search_TextChanged" QueryIcon="Find" MinWidth="160" AutomationProperties.Name="Поиск по всему каталогу"/>
    <ComboBox x:Name="TypeFilter" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="Filter_Changed" AutomationProperties.Name="Тип медиа"><ComboBoxItem Content="Все форматы"/><ComboBoxItem Content="Фото"/><ComboBoxItem Content="Видео"/><ComboBoxItem Content="RAW"/></ComboBox>
    <ComboBox x:Name="SortFilter" Grid.Column="2" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="Filter_Changed" AutomationProperties.Name="Сортировка"><ComboBoxItem Content="Сначала новые"/><ComboBoxItem Content="По имени"/><ComboBoxItem Content="По размеру"/><ComboBoxItem Content="По формату"/></ComboBox>
    <Button Grid.Column="3" Click="Refresh_Click" ToolTipService.ToolTip="Обновить выбранный источник" AutomationProperties.Name="Обновить источник"><FontIcon Glyph="&#xE72C;" FontSize="15"/></Button>
   </Grid>
   <Grid Grid.Row="2">
    <GridView x:Name="Gallery" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Gallery_ItemClick" ContainerContentChanging="Gallery_ContainerContentChanging" HorizontalContentAlignment="Stretch" Padding="0,0,0,20">
     <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="244" ItemHeight="231"/></ItemsPanelTemplate></GridView.ItemsPanel>
     <!-- Virtualized GridView + ItemsWrapGrid follows the MIT WinUI Gallery pattern; see THIRD_PARTY_NOTICES.md. -->
     <GridView.ItemTemplate><DataTemplate x:DataType="local:MediaCard">
      <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Margin="0,0,12,12" DoubleTapped="Card_DoubleTapped">
       <Grid><Grid.RowDefinitions><RowDefinition Height="158"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Background="#292F29" CornerRadius="12,12,0,0">
         <FontIcon Glyph="&#xE91B;" FontSize="32" Foreground="#596458" HorizontalAlignment="Center" VerticalAlignment="Center"/>
         <Image Source="{x:Bind Preview, Mode=OneWay}" Stretch="UniformToFill" AutomationProperties.Name="Миниатюра"/>
         <Border Background="#CF171C17" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Bottom" Padding="6,3" Margin="10"><TextBlock Text="{x:Bind Badge}" FontSize="10" Foreground="#E4EBDD"/></Border>
         <CheckBox IsChecked="{x:Bind Selected, Mode=TwoWay}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,4,0,0" MinWidth="32" AutomationProperties.Name="Выбрать для импорта"/>
         <ToggleButton IsChecked="{x:Bind Favorite, Mode=TwoWay}" Content="{x:Bind FavoriteGlyph, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Width="30" Height="30" Padding="0" Background="#CF171C17" Foreground="{StaticResource Accent}" BorderThickness="0" AutomationProperties.Name="Избранное PhotoFlow"/>
        </Grid>
        <StackPanel Grid.Row="1" Margin="12,10" Spacing="4"><TextBlock Text="{x:Bind Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{x:Bind Details, Mode=OneWay}" FontSize="10" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/></StackPanel>
       </Grid>
      </Border>
     </DataTemplate></GridView.ItemTemplate>
    </GridView>
    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18" MaxWidth="490" Margin="0,0,0,60">
     <Border Background="#263220" CornerRadius="18" Width="64" Height="64" HorizontalAlignment="Left"><FontIcon Glyph="&#xEB9F;" Foreground="{StaticResource Accent}" FontSize="28"/></Border>
     <TextBlock Text="Меньше лишнего.&#x0a;Больше любимого." FontSize="42" FontWeight="SemiBold" LineHeight="49"/>
     <TextBlock Text="Сначала посмотрите и выберите удачные кадры.&#x0a;На компьютер попадёт только то, что вы отметите." Foreground="{StaticResource Muted}" FontSize="15" LineHeight="25" TextWrapping="Wrap"/>
     <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0"><Button Content="Открыть папку" Style="{StaticResource PrimaryButton}" Click="OpenFolder_Click"/><Button Content="Попробовать демо →" Click="Demo_Click" Padding="18,12" CornerRadius="10"/></StackPanel>
    </StackPanel>
   </Grid>
   <StackPanel Grid.Row="3" Margin="0,8,0,12" Spacing="8"><ProgressBar x:Name="Progress" Visibility="Collapsed" IsIndeterminate="True" Height="3" Foreground="{StaticResource Accent}"/><Button x:Name="StopButton" Content="Остановить" Click="Cancel_Click" Visibility="Collapsed"/><TextBlock x:Name="StatusLabel" Text="Оригиналы остаются на месте. Избранное сохраняется только в PhotoFlow." FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel>
  </Grid>
  <Grid Grid.Row="2" Grid.Column="1" Background="#202720" Padding="32,16" ColumnSpacing="20">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center" Spacing="4"><TextBlock x:Name="SelectionLabel" Text="Выберите то, что хочется сохранить" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="SelectionDetails" Text="Галочка — импортировать. Звезда — добавить в избранное." FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Content="Снять" Click="Clear_Click" Padding="10" CornerRadius="8"/><Button x:Name="SelectAllButton" Content="Выбрать все" Click="SelectAll_Click" Padding="12,10" CornerRadius="8"/></StackPanel>
   <Button Grid.Column="2" x:Name="ImportButton" Content="Импортировать →" Click="Import_Click" Style="{StaticResource PrimaryButton}" IsEnabled="False" VerticalAlignment="Center"/>
  </Grid>
 </Grid>
</Window>
