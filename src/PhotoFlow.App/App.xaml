<Application x:Class="PhotoFlow.App.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" /></ResourceDictionary.MergedDictionaries>
   <SolidColorBrush x:Key="Accent" Color="#D0F590" />
   <SolidColorBrush x:Key="CanvasBrush" Color="#161917" />
   <SolidColorBrush x:Key="PanelBrush" Color="#202420" />
   <SolidColorBrush x:Key="Muted" Color="#A6AEA5" />
   <Color x:Key="SystemAccentColor">#D0F590</Color>
   <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#D0F590" />
   <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#BDE37E" />
   <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#ADD16F" />
   <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#172012" />
   <Style x:Key="NavButton" TargetType="Button">
    <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="16,12" /><Setter Property="CornerRadius" Value="10" />
   </Style>
   <Style x:Key="PrimaryButton" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource Accent}" /><Setter Property="Foreground" Value="#172012" />
    <Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="22,13" />
    <Setter Property="CornerRadius" Value="10" /><Setter Property="FontWeight" Value="SemiBold" />
   </Style>
  </ResourceDictionary>
 </Application.Resources>
</Application>
